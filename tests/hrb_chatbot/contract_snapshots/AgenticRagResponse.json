{
  "$defs": {
    "ToolCallInfo": {
      "properties": {
        "tool_input": {
          "description": "What the agent passed to it.",
          "title": "Tool Input",
          "type": "string"
        },
        "tool_name": {
          "description": "Which tool the agent called.",
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "tool_input"
      ],
      "title": "ToolCallInfo",
      "type": "object"
    }
  },
  "description": "What POST /query returns.",
  "properties": {
    "answer": {
      "description": "The agent's final answer.",
      "title": "Answer",
      "type": "string"
    },
    "conversation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Echoed/generated when enable_conversation_memory was true - pass it back on the next call to continue this conversation. Null when memory wasn't enabled.",
      "title": "Conversation Id"
    },
    "iterations": {
      "description": "How many reasoning rounds the agent actually took.",
      "title": "Iterations",
      "type": "integer"
    },
    "query": {
      "description": "The question that was asked.",
      "title": "Query",
      "type": "string"
    },
    "tools_used": {
      "description": "Every tool call the agent made, in order.",
      "items": {
        "$ref": "#/$defs/ToolCallInfo"
      },
      "title": "Tools Used",
      "type": "array"
    }
  },
  "required": [
    "query",
    "answer",
    "tools_used",
    "iterations"
  ],
  "title": "AgenticRagResponse",
  "type": "object"
}
