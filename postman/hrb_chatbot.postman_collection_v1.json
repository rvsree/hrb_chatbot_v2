                {
                  "key": "files",
                  "type": "text",
                  "value": "In Postman, replace this row with a File field pointing at any non-PDF (e.g. a .txt)."
                }
              ]
            },
            "description": "Still 200 - the bad file is rejected on its own, the good one still lands."
          }
        },
        {
          "name": "Edge — no file provided (422)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/index/v1/rag/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "index",
                "v1",
                "rag",
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": []
            }
          }
        },
        {
          "name": "Idempotent replay",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/index/v1/rag/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "index",
                "v1",
                "rag",
                "documents"
              ]
            },
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "postman-demo-key-001"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{kb_docs_dir}}/JPMC Paid TimeOff.pdf"
                }
              ]
            },
            "description": "Send this exact request twice. Same document_id both times - the second call replays the cached response instead of uploading again. Change the header value to get a genuinely new document_id."
          }
        }
      ]
