                "v1",
                "rag",
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{kb_docs_dir}}/JPMC Healthcare Benefits.pdf"
                }
              ]
            },
            "description": "Copy results[0].document_id from the response into the document_id variable for folders 3 and 4."
          }
        },
