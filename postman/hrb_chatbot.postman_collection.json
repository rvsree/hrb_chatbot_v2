          }
        },
        {
          "name": "Edge — unknown id (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/does-not-exist",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "does-not-exist"
              ]
            },
            "description": "Every error in this API returns the same {\"error\": \"...\"} shape, never a raw stack trace, regardless of status code."
          }
        },
        {
          "name": "Delete one document (full delete: vectors + metadata + file)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}"
              ]
            },
            "description": "Deletes the document's vectors (if indexed), its metadata row, and its uploaded file, all in one call. Not selective - a document has one current state, not a retained version history to pick from. Expect 200 with chunks_removed (0 if it was never indexed). Run one of folder 2's upload requests first if document_id is empty."
          }
        },
        {
          "name": "Edge — delete unknown id (404)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/does-not-exist",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "does-not-exist"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Index — POST /v1/rag-ingestion/documents/{id}/index",
      "item": [
        {
          "name": "Default settings",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}/index",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}",
                "index"
              ]
            },
            "description": "Spends one real embedding call. Auto-selects a chunking strategy - see the 'Chunking strategy' requests below to pick one explicitly."
          }
        },
        {
          "name": "Chunking strategy - dedicated endpoint (recursive)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}/index/recursive",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}",
                "index",
                "recursive"
              ]
            },
            "description": "One dedicated URL per chunking technique - swap 'recursive' for 'fixed', 'semantic', 'markdown', 'html', or 'none'. Spends one real embedding call ('semantic' spends one per sentence, more expensive than the others)."
          }
        },
        {
          "name": "Chunking strategy - via request body (none)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}/index",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}",
                "index"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chunking_strategy\": \"none\"\n}"
            },
            "description": "Dynamic selection via the request body instead of a dedicated URL - same underlying pipeline. 'none' = whole document as one chunk, no splitting."
          }
        },
        {
          "name": "Edge — unknown chunking strategy in URL (404)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}/index/not-a-real-strategy",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}",
                "index",
                "not-a-real-strategy"
              ]
            },
            "description": "Expect 404, naming the unknown strategy and listing the valid ones."
          }
        },
        {
          "name": "Custom chunk size/overlap + vector store",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}/index",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}",
                "index"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chunk_size\": 500,\n  \"chunk_overlap\": 50,\n  \"vector_db\": \"chromadb\"\n}"
            },
            "description": "All fields optional - each defaults to the .env-wide setting when omitted. Spends one real embedding call."
          }
        },
        {
          "name": "Index against Pinecone instead of ChromaDB",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}/index/recursive",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}",
                "index",
                "recursive"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vector_db\": \"pinecone\"\n}"
            },
            "description": "Writes via LlamaIndex's VectorStoreIndex into the real Pinecone index (PINECONE_INDEX_NAME) instead of ChromaDB - same response shape either way. Spends one real embedding call per chunk."
          }
        },
        {
          "name": "Edge — overlap ≥ chunk size (422)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}/index",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}",
                "index"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chunk_size\": 200,\n  \"chunk_overlap\": 200\n}"
            }
          }
        },
        {
          "name": "Edge — chunk size below minimum (422)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}/index",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}",
                "index"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chunk_size\": 50\n}"
            },
            "description": "Minimum is 100."
          }
        },
        {
          "name": "Edge — unknown vector store name (422)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}/index",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "{{document_id}}",
                "index"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vector_db\": \"made_up_store\"\n}"
            },
            "description": "vector_db is a closed set ('chromadb' or 'pinecone') on the request model, so an unrecognized value is rejected right here with a 422 naming the valid options - it never reaches the indexing pipeline, unlike the generic 500 this used to produce before vector_db became an enum."
          }
        },
        {
          "name": "Edge — unknown document id (404)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents/does-not-exist/index",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents",
                "does-not-exist",
                "index"
              ]
            },
            "description": "No embedding call is made - fails before spending anything."
          }
        }
      ]
    },
    {
      "name": "5. Query — POST /v1/rag-retrieval/query",
      "description": "Real retrieval + grounded generation (MVP, as of 2026-09-10) - not a stub. A well-formed query spends one real embedding call + one real chat completion, and needs the target content already indexed (run folder 2 then folder 4 on a real PDF first). Query decomposition, guardrails, and evaluations are still hand-written and not built. resources/golden_dataset/golden_dataset.json has 22 real question/expected-answer pairs grounded in the actual PDFs, ready to try here.",
      "item": [
        {
          "name": "Well-formed query (real grounded answer)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-retrieval/query",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-retrieval",
                "query"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"How many weeks of paid parental leave does JPMorgan Chase provide?\",\n  \"top_k\": 5\n}"
            },
            "description": "Expect 200, a real answer grounded in whatever's actually indexed, sources with real filename/chunk_index/score, and model_used naming the model that generated it. If nothing relevant is indexed yet, expect a fixed \"I don't have any information about that\" answer with empty sources, not an error."
          }
        },
        {
          "name": "MMR search - dedicated endpoint",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-retrieval/query/mmr",
              "host": [
