            {
              "name": "Delete one document (full delete: vectors + metadata + file)",
              "request": {
                "method": "DELETE",
                "url": {
                  "raw": "{{base_url}}/v1/rag-ingestion/documents/{{document_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "v1",
                    "rag-ingestion",
                    "documents",
                    "{{document_id}}"
                  ]
                },
                "description": "Deletes the document's vectors (if indexed), its metadata row, and its uploaded file, all in one call. Not selective - a document has one current state, not a retained version history to pick from. Expect 200 with chunks_removed (0 if it was never indexed). Run one of folder 2's upload requests first if document_id is empty."
              }
            },
            {
              "name": "Edge — delete unknown id (404)",
              "request": {
                "method": "DELETE",
                "url": {
                  "raw": "{{base_url}}/v1/rag-ingestion/documents/does-not-exist",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "v1",
                    "rag-ingestion",
                    "documents",
                    "does-not-exist"
                  ]
                }
              }
            },
            {
              "name": "Delete ALL documents (Phase 27)",
              "request": {
                "method": "DELETE",
                "url": {
                  "raw": "{{base_url}}/v1/rag-ingestion/documents",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "v1",
                    "rag-ingestion",
                    "documents"
                  ]
                },
                "description": "Deletes EVERY document - vectors, metadata rows, uploaded files. Same full-delete semantics as the single-document DELETE, just for all of them at once. No confirmation flag (matches the single-delete endpoint, which also has none). Returns documents_deleted and total chunks_removed."
              }
            }
          ]
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
