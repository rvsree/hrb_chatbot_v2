                },
                "description": "Expect 422, naming the unknown strategy and listing the valid ones."
              }
            },
            {
              "name": "Edge - unknown llm_provider (422)",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{base_url}}/v1/rag-retrieval/query",
