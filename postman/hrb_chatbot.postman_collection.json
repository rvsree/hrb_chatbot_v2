              "pm.request.headers.upsert({key: \"X-Employee-Id\", value: \"E00001\"});",
              "pm.request.headers.upsert({key: \"X-Full-Name\", value: \"Hana Support\"});",
              "pm.request.headers.upsert({key: \"X-Role\", value: \"hr_support\"});"
            ]
          }
        }
      ],
      "description": "Every request in this folder is gated to the HR_SUPPORT role by the Phase 23 gateway - a folder-level pre-request script injects the placeholder identity headers automatically."
