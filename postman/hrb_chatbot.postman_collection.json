    {
      "name": "2. Upload — POST /v1/rag-ingestion/documents",
      "item": [
        {
          "name": "Single PDF",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{kb_docs_dir}}/JPMC Healthcare Benefits.pdf"
                }
              ]
            },
            "description": "Uploads one PDF. On success, this request's Tests script auto-saves results[0].document_id into the document_id collection variable - folders 3 and 4 pick it up automatically, no manual copy-paste needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Auto-saves the new document_id so you do not have to copy it by hand.",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"document_id\", body.results[0].document_id);",
                  "    console.log(\"document_id set to:\", body.results[0].document_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Batch, two valid PDFs",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{kb_docs_dir}}/JPMC Paid TimeOff.pdf"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{kb_docs_dir}}/JPMC Guild Tuition Assistance.pdf"
                }
              ]
            }
          }
        },
        {
          "name": "Edge — one invalid file in a batch",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{kb_docs_dir}}/JPMC Unpaid TimeOff.pdf"
                },
                {
                  "key": "files",
                  "type": "text",
                  "value": "In Postman, replace this row with a File field pointing at any non-PDF (e.g. a .txt)."
                }
              ]
            },
            "description": "Still 200 - the bad file is rejected on its own, the good one still lands."
          }
        },
        {
          "name": "Edge — no file provided (422)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": []
            }
          }
        },
        {
          "name": "Upload a new version of an existing document (supersedes_document_id)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "rag-ingestion",
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{kb_docs_dir}}/JPMC Guild Tuition Assistance.pdf"
                },
                {
                  "key": "supersedes_document_id",
                  "type": "text",
                  "value": "{{document_id}}"
                }
              ]
            },
            "description": "Set the document_id variable to an existing (ideally already-indexed) document first. Only valid with exactly one file (422 on a batch - ambiguous which file supersedes it) and only if the target id exists (per-file \"rejected\" otherwise). The old document is NOT flipped to is_current=false yet at this point - only once THIS upload is indexed (folder 4) does that happen. Check the old document afterward (folder 3) to see is_current go false and superseded_by get set; a folder-5 query should then only ever cite the new document."
          }
        }
      ]
    },
    {
      "name": "3. List, get & delete — GET/DELETE /v1/rag-ingestion/documents[/{id}]",
      "item": [
        {
          "name": "List all",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/rag-ingestion/documents",
              "host": [
